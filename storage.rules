rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function canAccessProject(projectId) {
      return request.auth != null && (
        isAdmin() || (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'client' &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.clientId ==
          firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientId
        )
      );
    }
    
    match /projects/{projectId}/{allPaths=**} {
      allow read: if canAccessProject(projectId);
      allow write: if canAccessProject(projectId);
    }

    // Settings-Assets (z.B. Logo unter settings/logo.png)
    match /settings/{allPaths=**} {
      // Lesen für eingeloggte Nutzer erlaubt
      allow read: if request.auth != null;
      // Schreiben nur für Admins
      allow write: if isAdmin();
    }
  }
}
